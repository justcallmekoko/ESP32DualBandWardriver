{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ESP32 C5 Wardriver installer release manifest",
  "type": "object",
  "required": ["$schema", "schemaVersion", "kind", "metadataStatus", "sourceRepository", "sourceCommit", "channel", "version", "targets"],
  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "schemaVersion": { "const": 1 },
    "kind": { "const": "esp32-c5-wardriver-installer-release" },
    "metadataStatus": { "const": "authoritative" },
    "sourceRepository": { "const": "justcallmekoko/ESP32DualBandWardriver" },
    "sourceCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "channel": { "const": "stable" },
    "version": { "type": "string", "pattern": "^v[0-9A-Za-z._-]+$" },
    "targets": { "type": "array", "minItems": 1 }
  },
  "additionalProperties": false
}
